# PlatformIO build artifacts
firmware/.pio/
firmware/.vscode/

# OS
.DS_Store

# Claude Code -- project skills/hooks/settings.json ARE versioned (they
# encode the build/flash/QA workflow); only per-machine state is ignored.
.claude/settings.local.json
.claude/skills/graphify/
.claude/worktrees/

# graphify -- the graph is a local, regenerable index
graphify-out/

# Local screenshot captures (screenshots/*.png committed ones are docs)
/screenshot.png

# Node tooling deps (npm install --no-save)
tools/node_modules/
tools/package-lock.json

# Mac daemon venv
daemon/.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Cloud dashboard (cloud/) build output and local env
cloud/node_modules/
cloud/.next/
cloud/next-env.d.ts
cloud/*.tsbuildinfo
cloud/.env*.local
cloud/.vercel/
